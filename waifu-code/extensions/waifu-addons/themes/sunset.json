	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#c3a1a5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#f8b3d8"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted"
			],
			"settings": {
				"foreground": "#b8ddad"
			}
